#usda 1.0
(
    defaultPrim = "Scene"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scene"
{
    def Material "BlueMaterial"
    {
        token outputs:surface.connect = </Scene/BlueMaterial/Preview.outputs:surface>

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.3, 0.8)
            token outputs:surface
        }
    }

    def Mesh "Triangle"
    {
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        texCoord2f[] primvars:st_0 = [(0, 0), (1, 0), (0, 1)] (interpolation = "vertex")
        rel material:binding = </Scene/BlueMaterial>
    }
}
