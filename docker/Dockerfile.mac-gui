# Linux GUI examples viewed in a macOS browser through noVNC.
FROM python:3.12-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11-utils x11vnc novnc websockify \
    libgl1 libgl1-mesa-dri libglib2.0-0 tk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY pybullet_fleet/ ./pybullet_fleet/
RUN python -m pip install --no-cache-dir .

COPY docker/run_gui_example.sh /usr/local/bin/run_gui_example
RUN chmod +x /usr/local/bin/run_gui_example

EXPOSE 6080
ENTRYPOINT ["run_gui_example"]
